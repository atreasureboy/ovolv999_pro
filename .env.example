# ovolv999 Configuration
# Copy to .env and fill in your API key
#
#   cp .env.example .env
#   # edit .env with your values

# ── Required ──────────────────────────────────────────────────────────

# Your API key for the LLM provider.
# Required for all providers (OpenAI, Anthropic, OpenRouter, etc.)
OPENAI_API_KEY=sk-your-key-here

# ── Optional: Provider / Endpoint ─────────────────────────────────────

# Custom base URL for OpenAI-compatible proxies/gateways.
# Examples: OpenRouter, Azure OpenAI, Ollama, local proxy
# OPENAI_BASE_URL=https://your-proxy.com/v1

# Anthropic-specific API key (if using Anthropic Messages API directly).
# If not set, falls back to OpenAI-compatible mode (for gateways like OpenRouter).
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Anthropic API endpoint (default: https://api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Optional: Model ───────────────────────────────────────────────────

# Override the default model (default: gpt-4o).
# Supports any model your provider/gateway exposes.
# OVOGO_MODEL=claude-sonnet-4-5
# OVOGO_MODEL=deepseek-chat
# OVOGO_MODEL=gemini-2.5-pro
# OVOGO_MODEL=llama-3.1-70b

# ── Optional: Runtime ─────────────────────────────────────────────────

# Maximum Think-Act-Observe iterations per run (default: 200).
# Prevents infinite loops; the engine terminates gracefully when exhausted.
# OVOGO_MAX_ITER=200

# Shell to use for Bash tool execution (default: bash on Linux/macOS, cmd on Windows).
# OVOGO_SHELL=bash

# Working directory override (default: current directory).
# OVOGO_CWD=/path/to/project

# ── Optional: Cost budget ────────────────────────────────────────────

# Stop the agent when cumulative LLM cost reaches this USD ceiling.
# The engine checks the budget before each LLM call and exits gracefully
# with reason "budget_exceeded". Requires `pricing` in .ovogo/agent.json
# for accurate accounting (without it, token costs are estimated).
# OVOGO_MAX_COST_USD=5.00

# ── Optional: Permissions ─────────────────────────────────────────────

# Default permission mode (auto | ask | deny). Default: auto.
# - auto: Allow by default; dangerous commands (rm -rf, sudo, etc.) prompt.
# - ask:  Prompt for every tool call unless rule matches allow/deny.
# - deny: Deny by default; only tools with explicit allow rules execute.
# OVOGO_PERMISSION=auto

# ── Optional: Configuration Files ─────────────────────────────────────

# Path to a custom agent configuration JSON file.
# If not set, defaults to .ovogo/agent.json in the working directory.
# OVOGO_AGENT_CONFIG=/path/to/agent.json
